<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DeashBoard</title>
    <link rel="stylesheet" href="css/main.css">
</head>
<body>
      <% if (typeof user !=="undefined" && user) { %>
        <div class="cont-user">
            <p><%= user.name %></p>
            <div class="icon">
                <p><%= user.name[0] %></p>
            </div>

        </div>
    <% } %>
    <main>
        <header>
            <h1>
                <%= title %>
            </h1>
        </header>
        <section></section>
    </main>
    <footer>
        <p>2026 . user rules by Pedro Vitor</p>
    </footer>

</body>
</html>